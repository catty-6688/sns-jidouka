OPENAI_API_KEY=sk-ここにあなたのAPIキーを入れてください
OPENAI_MODEL=gpt-5-mini

# Vercel公開後のURL。例: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Meta Developers > Threads API の設定値
THREADS_APP_ID=
THREADS_APP_SECRET=

# まず1アカウントだけで運用する場合はここに長期Threads User Access Tokenを入れてもOK
THREADS_ACCESS_TOKEN=ここにThreadsアクセストークンを入れてもOK

# X公式APIを使う場合に設定。未設定またはX_PROVIDER=mockならMockXProviderで画面確認できます。
# 軽運用の目安: 1日1回、検索条件3〜5個、各条件10〜20件取得。
X_PROVIDER=mock
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
